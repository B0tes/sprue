# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
skills/distinta/examples/*/fab/
skills/distinta/examples/*/pcb/
skills/distinta/examples/*/production/
skills/distinta/examples/*/history/
skills/distinta/examples/*/view.html
skills/distinta/examples/*/shots/
# a firmware run's report, of the pcb/ files above; firmware/code.py and README.md are product files and are committed
skills/distinta/examples/*/firmware/fil.json
public/distinta.zip
__pycache__/
public/examples/
