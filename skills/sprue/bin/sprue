#!/bin/sh
# The Sprue command line. It is not on PATH: after installing the skill, run
# ~/.claude/skills/sprue/bin/sprue; inside the sprue repo, run skills/sprue/bin/sprue
# (or npm run sprue --). Run it with no arguments for the list of commands.
# Products are read from and written to ./products/<slug>/ in the current folder.
root="$(cd "$(dirname "$0")/.." && pwd)"
exec node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \
  --disable-warning=ExperimentalWarning "$root/pipeline/cli.ts" "$@"
