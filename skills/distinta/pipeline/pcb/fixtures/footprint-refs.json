      "title": "Kailh CPG151101S11 hot-swap socket under a Cherry MX switch",
      "pads": [
        {"num": "A", "srcNum": "1", "at": [7.36, -2.54], "size": [2.55, 2.5], "src": "marbastlib", "also": ["keebio"], "sizeSrc": "kailh"},
